{
  // Cloudflare Workers config. The Astro adapter fills in the entry point and static
  // assets at build time; settings here are merged into that.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "world-transit",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Claims kylepace.dev/world-transit on the hub's domain, plus the old Washington map's
  // /transit addresses, which redirect here (src/pages/transit/[...path].ts). Routes win
  // over the hub's Custom Domain, so only these paths reach this Worker.
  "routes": [
    { "pattern": "kylepace.dev/world-transit", "zone_name": "kylepace.dev" },
    { "pattern": "kylepace.dev/world-transit/*", "zone_name": "kylepace.dev" },
    { "pattern": "kylepace.dev/transit", "zone_name": "kylepace.dev" },
    { "pattern": "kylepace.dev/transit/*", "zone_name": "kylepace.dev" }
  ],
  "workers_dev": true,
  // The tiles (/world-transit/world.pmtiles), too big for static assets (25 MB limit).
  // Uploaded by scripts/build-globe.ts --upload.
  "r2_buckets": [{ "binding": "TILES", "bucket_name": "kylepace-transit-tiles" }]
  // Secret (not in Git): OBA_API_KEY, the OneBusAway Puget Sound key for Sound Transit,
  // Pierce Transit, WSF and the Seattle Streetcar. Without it the shared TEST key is used.
}
