{
  "name": "world-transit",
  "version": "0.1.0",
  "description": "Every transit route on Earth with an open schedule, on one globe, with vehicles moving live where agencies share them, at kylepace.dev/world-transit/.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "data": "node --max-old-space-size=6000 scripts/build-globe.ts",
    "astro": "astro",
    "check": "node .agents/skills/page-check/check.mjs --js-budget 400 --pages /world-transit/,/world-transit/about/,/world-transit/agencies/,/world-transit/agencies/us/,/world-transit/agencies/fi/,/world-transit/agencies/jp/",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "astro": "^7.4.7",
    "kp-design": "github:kyle-pace/kp-design#de5a96dbd2f9a9478788b18714b8b81b23946480",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "^1.65.1",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.158.0"
  }
}
