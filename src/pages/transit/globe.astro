---
// The transit globe (/transit/globe/), a prototype: every route and stop in the world's open
// schedules on a globe, with live vehicles. Logic: src/components/transit-globe.ts. Data:
// world.pmtiles (R2) and public/transit/globe/world.json, built by scripts/build-globe.ts.
// Same look as the live map (design/PLAN.md): the map fills the window with one sign on it.
import LabLayout from 'kp-design/layouts/LabLayout.astro';
import '../../styles/theme.css';
import { ICONS, type IconMode } from '../../components/transit-icons';

// Optional at build time: the summary only exists once scripts/build-globe.ts has run.
type Summary = { updated: string; countries: string[]; feeds: number; agencies: number; routes: number; stops: number };
const found = import.meta.glob<Summary>('../../../public/transit/globe/world.json', { eager: true, import: 'default' });
const summary: Summary | null = Object.values(found)[0] ?? null;
const n = (x: number) => x.toLocaleString('en-US');

// Live vehicle feeds (scripts/build-globe.ts): just what the page needs, the URLs stay
// with the Worker (src/pages/transit/api/globe/[feed].json.ts).
type LiveList = { feeds: { id: string; name: string; static: string; bbox: number[] }[] };
const liveFound = import.meta.glob<LiveList>('../../lib/globe-live.json', { eager: true, import: 'default' });
const liveList: LiveList = Object.values(liveFound)[0] ?? { feeds: [] };

const modes: { value: IconMode; label: string; bold: boolean }[] = [
  { value: 'rail', label: 'Trains', bold: true },
  { value: 'tram', label: 'Light rail and streetcars', bold: true },
  { value: 'ferry', label: 'Ferries', bold: true },
  { value: 'bus', label: 'Buses', bold: false },
];
---

<LabLayout
  title="World transit on a globe"
  description="Every bus, train and ferry route with an open schedule, on one globe you can spin and zoom into a single street, with vehicles moving live where agencies share them."
  image="/transit/share.png"
  imageAlt="Washington transit: the name on a green sign beside a dark map of Puget Sound's transit routes in many colors."
  themeColor={{ light: '#eceee8', dark: '#121719' }}
>
  <ul class="lab-nav" slot="bar">
    <li><a href="/transit/">Live map</a></li>
    <li><a href="/transit/agencies/">Agencies</a></li>
    <li><a href="/transit/about/">About</a></li>
  </ul>

  <section class="transit" id="transit-globe" data-country="world" aria-labelledby="globe-title">
    <div class="frame" data-frame>
      <div class="sign">
        <div class="plate sign-plate">
          <h1 id="globe-title">World transit</h1>
          <p class="readout" data-status aria-live="polite">
            {summary ? `${n(summary.routes)} routes from ${n(summary.agencies)} agencies in ${summary.countries.length} countries` : 'Routes not built yet'}
          </p>
          <p class="readout live" data-live-status aria-live="polite">Zoom in to a region to see live vehicles</p>
        </div>
        <div class="sign-body">
          <div class="search">
            <label class="visually-hidden" for="globe-search">Find a place or agency</label>
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M10.5 3a7.5 7.5 0 0 1 5.96 12.05l4.25 4.24-1.42 1.42-4.24-4.25A7.5 7.5 0 1 1 10.5 3Zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Z"></path></svg
            >
            <input
              id="globe-search"
              type="search"
              data-search
              placeholder="Find a place or agency"
              autocomplete="off"
              role="combobox"
              aria-autocomplete="list"
              aria-controls="globe-results"
              aria-expanded="false"
            />
            <ul id="globe-results" class="results" data-results role="listbox" aria-label="Places and agencies" hidden></ul>
          </div>
          <p class="random">
            <button type="button" data-random>
              <svg viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm2.5 3a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm9 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm-4.5 4.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3ZM7.5 15a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm9 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"
                ></path></svg
              >
              Somewhere random
            </button>
            <span class="random-where" data-random-where aria-live="polite"></span>
          </p>
          <details class="layers" data-layers open>
            <summary>
              <span>What’s on the map</span>
              <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"
                ><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
              >
            </summary>
            <fieldset class="legend">
              <legend>Show</legend>
              {
                modes.map((m) => (
                  <label class="row">
                    <input type="checkbox" data-mode value={m.value} checked />
                    <svg class="pictogram" viewBox="0 0 24 24" aria-hidden="true">
                      <path d={ICONS[m.value]} fill-rule="evenodd" />
                    </svg>
                    <span class="row-label">{m.label}</span>
                    <svg class:list={['stroke', { bold: m.bold }]} viewBox="0 0 40 12" aria-hidden="true">
                      <path d="M2 6h36" />
                    </svg>
                  </label>
                ))
              }
            </fieldset>
            <fieldset class="legend">
              <legend>Live</legend>
              <label class="row">
                <input type="checkbox" data-live checked />
                <svg class="pictogram" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="6" fill="currentColor"></circle></svg>
                <span class="row-label">Vehicles reporting where they are ({n(liveList.feeds.length)} agencies)</span>
              </label>
              <label class="row">
                <input type="checkbox" data-live-only />
                <svg class="pictogram" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle><circle cx="12" cy="12" r="3" fill="currentColor"></circle></svg>
                <span class="row-label">Only places with live vehicles</span>
              </label>
            </fieldset>

          </details>
        </div>
      </div>
      <div class="map" data-map role="region" aria-label="Globe of transit routes and live vehicles. Drag to spin, scroll or pinch to zoom."></div>
    </div>
  </section>

  <div class="below">
    <section class="about" aria-labelledby="about-heading">
      <h2 id="about-heading">About</h2>
      <p>
        {
          `Routes come from the schedules agencies publish openly (GTFS), found through the Mobility Database${summary ? `: ${n(summary.feeds)} sources, ${n(summary.routes)} routes and ${n(summary.stops)} stops in ${summary.countries.length} countries` : ''}. Where a country publishes no open schedules, the lines come from OpenStreetMap, which shows where they run but not when. Long train and ferry lines show from orbit, shorter ones as you come closer; buses and trams appear at region level, and stops at city level. Tap a line to see its name and who runs it.`
        }
      </p>
      <p>
        Live vehicles come from each agency’s open feed (GTFS-realtime), for the part of the map you’re looking at, and refresh
        every 15 seconds. This is a first look at taking the <a href="/transit/">Washington live map</a> worldwide.
      </p>
      <p>
        Map tiles by <a href="https://openfreemap.org">OpenFreeMap</a>, map data © OpenStreetMap contributors. Privacy: your
        browser asks OpenFreeMap’s servers for the part of the map you’re looking at. Analytics works the same as the rest of
        kylepace.dev (<a href="https://kylepace.dev/privacy/">privacy</a>).
      </p>
    </section>
  </div>
</LabLayout>

<script is:inline>
  if (matchMedia('(max-width: 47.99rem)').matches) document.querySelector('[data-layers]')?.removeAttribute('open');
</script>

<script>
  import { startGlobe } from '../../components/transit-globe';

  const root = document.getElementById('transit-globe');
  if (root) startGlobe(root);
</script>

<style>
  .frame {
    position: relative;
    display: flex;
    flex-direction: column;
    height: calc(100dvh - var(--bar-h) - 3rem);
    min-height: 32rem;
    background: var(--bg);
  }

  .frame:fullscreen {
    height: 100vh;
  }

  .map {
    flex: 1;
    min-height: 0;
  }

  .sign {
    position: relative;
    z-index: 3;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--line);
  }

  .sign-plate {
    padding: var(--space-3) var(--gutter);
  }

  h1 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .readout {
    margin: var(--space-1) 0 0;
    font-size: var(--step--1);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .sign-body {
    padding: var(--space-3) var(--gutter) 0;
  }

  /* ---------- Search (same look as the live map's) ---------- */

  .search {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search svg {
    position: absolute;
    left: var(--space-3);
    width: 1.15rem;
    height: 1.15rem;
    fill: var(--ink-muted);
    pointer-events: none;
  }

  .search input {
    width: 100%;
    min-height: 2.75rem;
    font: inherit;
    font-size: var(--step-0);
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--control-line);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3) var(--space-2) calc(var(--space-3) + 1.6rem);
  }

  .search input::placeholder {
    color: var(--ink-muted);
    opacity: 1;
  }

  .search input:focus-visible {
    outline: 3px solid var(--accent-ink);
    outline-offset: 1px;
  }

  .results {
    position: absolute;
    z-index: 5;
    top: calc(100% + var(--space-1));
    left: 0;
    right: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--bg-raised);
    border: 1px solid var(--control-line);
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.22);
    font-size: var(--step--1);
    overflow: hidden;
  }

  .results {
    max-height: min(60vh, 28rem);
    overflow-y: auto;
  }

  .results :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Group names: plain small type on a rule, not a label above a heading. */
  .results :global(.result-group) {
    display: block;
    padding: var(--space-2) var(--space-3) var(--space-1);
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .results > :global(li:first-child) > :global(.result-group) {
    border-top: 0;
  }

  .results :global([role='option']) {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }

  .results :global(.result-icon) {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    fill: var(--ink-muted);
  }

  .results :global(.result-text) {
    display: grid;
    min-width: 0;
  }

  .results :global([role='option'].active),
  .results :global([role='option']:hover) {
    background: color-mix(in oklab, var(--plate), transparent 85%);
  }

  .results :global(.result-label) {
    font-weight: 600;
  }

  .results :global(.result-detail) {
    color: var(--ink-muted);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chevron {
    width: 1rem;
    height: 1rem;
    color: var(--ink-muted);
  }

  .layers[open] .chevron {
    rotate: 180deg;
  }

  .legend {
    margin: 0 0 var(--space-3);
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
    margin-bottom: var(--space-1);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .row {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    min-height: 2.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
  }

  .row:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  .row input {
    width: 1.15rem;
    height: 1.15rem;
    margin: 0;
    flex: none;
    accent-color: var(--plate);
    cursor: pointer;
  }

  .row-label {
    flex: 1;
  }

  .pictogram {
    width: 1.3rem;
    height: 1.3rem;
    fill: var(--ink);
    flex: none;
  }

  .stroke {
    width: 2.5rem;
    height: 0.75rem;
    flex: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .stroke.bold {
    stroke-width: 5;
  }

  .row:has(input:not(:checked)) :is(.pictogram, .stroke) {
    opacity: 0.35;
  }

  /* Somewhere random: a quiet text button under the search, its destination beside it. */
  .random {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-2) 0 0;
    font-size: var(--step--1);
  }

  .random button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent-ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .random button:hover {
    text-decoration: underline;
  }

  .random button:focus-visible {
    outline: 3px solid var(--accent-ink);
    outline-offset: 2px;
  }

  .random svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }

  .random-where {
    color: var(--ink-muted);
  }


  @media (max-width: 47.99rem) {
    .layers[open] {
      max-height: 45dvh;
      overflow: auto;
    }
  }

  @media (min-width: 48rem) {
    .sign {
      position: absolute;
      top: var(--space-4);
      left: var(--space-4);
      width: 19rem;
      max-height: calc(100% - 2 * var(--space-4) - 1.5rem);
      overflow: auto;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 8px 28px rgb(0 0 0 / 0.2);
    }

    .sign-plate {
      padding: var(--space-4) var(--space-4) var(--space-3);
      border-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0;
    }

    h1 {
      font-size: var(--step-2);
    }

    .sign-body {
      padding: 0 var(--space-4) var(--space-1);
    }
  }

  .transit :global(.maplibregl-map) {
    font: inherit;
  }

  .transit :global(.maplibregl-ctrl-group) {
    background: var(--bg-raised);
    border-radius: var(--radius-sm);
    box-shadow: 0 0 0 1px var(--control-line);
  }

  .transit :global(.maplibregl-ctrl-group button) {
    width: 2.5rem;
    height: 2.5rem;
  }

  .transit :global(.maplibregl-ctrl-attrib) {
    background: color-mix(in oklab, var(--bg-raised), transparent 10%);
    color: var(--ink);
  }

  .transit :global(.maplibregl-ctrl-attrib a) {
    color: var(--ink);
  }

  .transit :global(.maplibregl-popup-content) {
    background: var(--bg-raised);
    color: var(--ink);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4) var(--space-2);
  }

  .readout.live {
    font-weight: 400;
    color: var(--plate-ink-muted);
  }

  .transit :global(.globe-vehicle) {
    display: grid;
    gap: var(--space-1);
    font-size: var(--step--1);
  }

  /* The route's color as a bar beside the name: the color is extra, the name says it. */
  .transit :global(.globe-vehicle strong) {
    padding-left: var(--space-2);
    border-left: 4px solid var(--route);
    font-size: var(--step-0);
  }

  .transit :global(.globe-vehicle span) {
    color: var(--ink-muted);
  }

  .transit :global(.globe-hits) {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .transit :global(.globe-hits li) {
    display: grid;
    grid-template-columns: 0.4rem 1fr;
    column-gap: var(--space-2);
    padding: var(--space-1) 0;
  }

  .transit :global(.globe-hits .swatch) {
    grid-row: span 2;
    border-radius: 2px;
  }

  .transit :global(.globe-hits span:last-child) {
    color: var(--ink-muted);
  }

  .below {
    padding: var(--space-8) var(--gutter) 0;
    max-width: 68rem;
  }

  .about {
    max-width: 40rem;
    font-size: var(--step--1);
  }

  .about h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--step-1);
  }

  .about p {
    max-width: 32em;
    margin: 0 0 var(--space-3);
  }
</style>
